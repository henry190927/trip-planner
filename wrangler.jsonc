{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trip-chat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // 對 Gemini 的請求經由固定在美西的 Durable Object 轉發，見 worker/relay.ts
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "GeminiRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeminiRelay"] }],
  "kv_namespaces": [{ "binding": "TRIPS", "id": "0f6242a045fb4b908da7a86f9ab10c00" }],
  // 網站本身（npm run build 的產物）也由這個 Worker 提供，跟 API 同一個網址：登入用的 cookie 不必跨網域。
  // 只有 /api/* 會進到 Worker 程式，其他直接回網頁檔（不算 Worker 請求次數）
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    "MODEL": "gemini-3.6-flash",
    "FALLBACK_MODELS": "gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite"
  }
  // 機密設定用 `wrangler secret put` 設定，不寫在這裡：GEMINI_API_KEY、TAVILY_API_KEY
}
